# Copy this file to .env and fill in the values.

# Server
PORT=3000
# Public URL of this API, used in email confirmation links
APP_URL=http://localhost:3000
# URL of the frontend; the password reset email links to CLIENT_URL/password-reset/<token>
CLIENT_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=usof

# Secret used to sign login tokens (any long random string)
JWT_SECRET=

# Mailtrap SMTP sandbox credentials
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
